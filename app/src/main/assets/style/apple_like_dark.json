{
  "version": 8,
  "name": "Apple-like Dark",
  "sources": {
    "protomaps": {
      "type": "vector",
      "url": "__PMTILES_URL__",
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#12141a" } },
    { "id": "earth", "type": "fill", "source": "protomaps", "source-layer": "earth", "paint": { "fill-color": "#1a1d24" } },
    { "id": "landuse_park", "type": "fill", "source": "protomaps", "source-layer": "landuse",
      "filter": ["in", "kind", "park", "forest", "wood", "grass", "nature_reserve", "recreation_ground"],
      "paint": { "fill-color": "#18271d" } },
    { "id": "water", "type": "fill", "source": "protomaps", "source-layer": "water", "paint": { "fill-color": "#0f2438" } },
    { "id": "buildings", "type": "fill", "source": "protomaps", "source-layer": "buildings", "minzoom": 14,
      "paint": { "fill-color": "#232833", "fill-opacity": 0.85 } },
    { "id": "roads_minor", "type": "line", "source": "protomaps", "source-layer": "roads",
      "filter": ["in", "kind", "minor_road", "service", "path"],
      "paint": { "line-color": "#2c313c", "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.5, 16, 3] } },
    { "id": "roads_medium", "type": "line", "source": "protomaps", "source-layer": "roads",
      "filter": ["==", "kind", "medium_road"],
      "paint": { "line-color": "#39414f", "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.8, 16, 5] } },
    { "id": "roads_major", "type": "line", "source": "protomaps", "source-layer": "roads",
      "filter": ["==", "kind", "major_road"],
      "paint": { "line-color": "#4a5468", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1, 16, 7] } },
    { "id": "roads_highway", "type": "line", "source": "protomaps", "source-layer": "roads",
      "filter": ["==", "kind", "highway"],
      "paint": { "line-color": "#5b6a86", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1.2, 16, 9] } },
    { "id": "boundaries", "type": "line", "source": "protomaps", "source-layer": "boundaries",
      "paint": { "line-color": "#3a3f4a", "line-dasharray": [2, 2], "line-width": 0.8 } }
  ]
}
